# 서버 설정. 값을 비우거나 줄을 지우면 기본값이 적용된다.

# reverse proxy basePath. 프록시가 접두사를 제거해서 전달하는 것을 전제로 링크 생성에만 쓴다 (예: /query)
BASE_PATH=
QUERY_HOST=127.0.0.1
QUERY_PORT=4444

DEFAULT_PROVIDERS=["perplexity"]
MAX_RETRY=2
RETRY_BACKOFF_SECONDS=30

# 확장 임대(lease): 확장이 작업을 가져간 뒤 이 시간 안에 진행/핑이 없으면 회수한다
LEASE_SECONDS=120
LEASE_SWEEP_INTERVAL_SECONDS=10

DB_PATH=user/database/query.db
# 카테고리별 시스템 프롬프트: general.md 와 <category>.md (웹 UI의 프롬프트 관리에서 편집)
PROMPTS_DIR=user/prompts
ANSWERS_DIR=user/answers
RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=24

MAX_QUERY_LENGTH=4000
ASK_DEFAULT_TIMEOUT_SECONDS=60
ASK_MAX_TIMEOUT_SECONDS=300
DISPLAY_TIMEZONE=Asia/Seoul

# --- 보안 (OWASP ASVS 5.0.0) ---
# API 토큰(쉼표로 여러 개 등록 가능. 토큰에 쉼표는 쓸 수 없고, #이 있으면 값을 큰따옴표로 감쌀 것). REST(/api)·MCP·확장 WebSocket이 모두 이 토큰을 쓴다.
# 설정 시 `Authorization: Bearer <token>` 필수(확장 WebSocket은 `?token=`). 웹 UI는 401을 받으면 토큰을 물어 이 브라우저에 저장한다.
# QUERY_HOST가 loopback이 아니면 반드시 설정해야 서버가 시작된다.
API_TOKEN=
# 허용할 브라우저 Origin(쉼표 구분). 비우면 요청 Host와 동일 출처와 브라우저 확장만 허용
ALLOWED_ORIGINS=
MAX_BODY_BYTES=262144
RATE_LIMIT_PER_MINUTE=300
# reverse proxy 뒤에서 X-Forwarded-For를 신뢰 (true/false)
TRUST_PROXY=false
