# 상세 설명: docs/PLAN.md §8
BASE_PATH=
PERPLEXITY_LOGIN_EMAIL=
GMAIL_OAUTH_CREDENTIALS_PATH=user/config/gmail_credentials.json
GMAIL_OAUTH_TOKEN_PATH=user/sessions/gmail_token.json
PLAYWRIGHT_SESSIONS_DIR=user/sessions
DEFAULT_PROVIDERS=["perplexity"]
MAX_CONCURRENT_WORKERS=4
MAX_RETRY=2
DB_PATH=user/query.db
SYSTEM_PROMPT_PATH=user/config/system_prompt.md
ANSWERS_DIR=user/answers
RETENTION_DAYS=7
ASK_DEFAULT_TIMEOUT_SECONDS=60
ASK_MAX_TIMEOUT_SECONDS=300

# systemd 서비스용 (install-systemd.sh)
QUERY_HOST=127.0.0.1
QUERY_PORT=8000

# 추가 설정 (docs/PLAN.md §8)
MAX_QUERY_LENGTH=4000
RETRY_BACKOFF_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=1
CLEANUP_INTERVAL_HOURS=24
DISPLAY_TIMEZONE=Asia/Seoul
GMAIL_ACCOUNT_EMAIL=

# Playwright 브라우저 (default | custom)
# custom(patchright)은 Cloudflare 통과율이 높은 headed 실행(false) 권장
BROWSER_PROVIDER=default
PLAYWRIGHT_HEADLESS=true
